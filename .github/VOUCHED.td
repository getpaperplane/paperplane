# Trust list for hafiezul/rove, independent of upstream contributor trust.
#
# Collaborators with write access are automatically trusted by the vouch
# workflow. Add external contributors only after a Paperplane maintainer vouches
# for them; upstream contributions do not establish trust in this repository.
#
# Syntax:
#   github:username
#   -github:username reason for denouncement
#
# Keep entries sorted alphabetically.
github:hafiezul
