# Optional: configure a Paperplane-owned Clerk and relay deployment.
# A fresh source build has cloud features disabled. Copy this file if you want
# local configuration, then fill in only identifiers belonging to your project.
# Do not add server-side secrets here.

# Clerk's free tier can be used for local development with your own instance.
# PAPERPLANE_CLERK_PUBLISHABLE_KEY=pk_test_...
# PAPERPLANE_CLERK_JWT_TEMPLATE=paperplane-relay
# PAPERPLANE_CLERK_CLI_OAUTH_CLIENT_ID=your-public-client-id

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in PAPERPLANE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# PAPERPLANE_APPLE_TEAM_ID=ABC1234567
# PAPERPLANE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/paperplane.provisionprofile
# PAPERPLANE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Cloud relay and hosted OAuth are not part of the self-hosted release.
# Supply only origins controlled by this project when those services exist.
# PAPERPLANE_RELAY_URL=https://relay.example.invalid
# Hosted client and shared prompt links default to Paperplane's static web app.
# Override this only for an owned staging deployment or fork.
# PAPERPLANE_HOSTED_APP_URL=https://paperplane.hafiezulzikry.com

# Mobile native identity is opt-in. Local development clients do not need EAS
# updates, a store account, or a Clerk passkey relying-party domain.
# PAPERPLANE_EXPO_PROJECT_ID=your-own-expo-project-id
# PAPERPLANE_EXPO_OWNER=your-own-expo-account
# PAPERPLANE_MOBILE_UPDATES_ENABLED=1
# PAPERPLANE_CLERK_RELYING_PARTY_DOMAIN=your-own-clerk-rp-domain
# EXPO_PUBLIC_MARKETING_SITE_URL=https://your-reviewed-legal-site.example

# Public, ingest-only mobile OpenTelemetry configuration.
# PAPERPLANE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# PAPERPLANE_MOBILE_OTLP_TRACES_DATASET=paperplane-mobile-traces-dev
# PAPERPLANE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
