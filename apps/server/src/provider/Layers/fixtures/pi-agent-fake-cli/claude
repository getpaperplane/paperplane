#!/usr/bin/env node
// Stands in for an agent CLI that streams JSON lines.
if (process.argv.slice(2).some((arg) => ["--version", "--help", "-v", "-h"].includes(arg))) {
  process.stdout.write("Fake CLI probe output\n");
  process.exit(process.argv.includes("--fail-probe") ? 1 : 0);
}
const lines = [
  {
    type: "assistant",
    message: {
      content: [{ type: "tool_use", id: "t1", name: "Read", input: { file_path: "README.md" } }],
    },
  },
  { type: "user", message: { content: [{ type: "tool_result", tool_use_id: "t1", content: "ok" }] } },
  { type: "result", result: "Review passed", usage: { input_tokens: 12, output_tokens: 4 } },
];
for (const line of lines) process.stdout.write(`${JSON.stringify(line)}\n`);
