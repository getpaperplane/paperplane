{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "paperplane-web",
  "compatibility_date": "2025-04-01",
  "main": "./cloudflare/worker.mjs",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "html_handling": "none",
    "run_worker_first": [
      "/",
      "/index.html",
      "/docs",
      "/docs/*",
      "/api",
      "/api/*",
      "/index.md",
      "/docs.md",
      "/llms.txt",
      "/robots.txt",
      "/sitemap.xml",
      "/openapi.json",
      "/schema/paperplane.json"
    ]
  },
  "routes": [
    {
      "pattern": "paperplane.hafiezulzikry.com",
      "custom_domain": true
    }
  ]
}
